# Copy to .env (never commit .env)

# Database (Supabase / Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# LLM (behind a provider interface; switch without code changes)
LLM_PROVIDER=openai          # openai | gemini | anthropic | cache
LLM_API_KEY=
LLM_MODEL=
LLM_CACHE_ONLY=false         # true = never call the network: cached answers or deterministic text (demo fallback)
LLM_CACHE_DIR=               # optional; default backend/decision_engine/llm_cache
LLM_BASE_URL=                # optional; override the provider's API host

# How decision_engine reads data from data_engine
DATA_SOURCE=fixture          # fixture | http | local
DATA_ENGINE_URL=http://localhost:8001

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
