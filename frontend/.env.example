# Copy to frontend/app/.env.local (never commit it)
# Live backend (the gateway: DATA_SOURCE=local uvicorn backend.gateway.main:app --port 8011)
NEXT_PUBLIC_API_BASE=http://localhost:8011
# true = never call the backend; replay the recorded demo from public/mock (works offline)
NEXT_PUBLIC_USE_MOCKS=false
# true = use the live backend, but fall back to the recorded demo if it cannot be reached (recommended for the public site)
NEXT_PUBLIC_MOCK_FALLBACK=false
