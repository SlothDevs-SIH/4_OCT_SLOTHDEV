{
  "version": "v1",
  "synthetic": false,
  "templates": [
    {
      "template_id": "tpl_hot_lead_followup",
      "title": "Follow up with the high-value unattended leads",
      "action_type": "outreach",
      "kpi": "lead_wins",
      "expected_direction": "up",
      "triggers": [
        "response_latency_over_sla",
        "unattended_high_value_leads"
      ],
      "factors": {
        "I": 0.8,
        "F": 0.9,
        "R": 0.5,
        "T": 0.9,
        "E": 0.25,
        "C": 0.05,
        "D": 0.1
      },
      "effort_min": 180,
      "cost_inr": 0,
      "time_to_signal_days": 7,
      "requires_approval": true,
      "approval_reason": "customer_outreach",
      "risks": [
        "Over-contacting a lead",
        "Discounting to close"
      ],
      "requires_data": [
        "lead_scores"
      ],
      "spend_change": "none",
      "recommendation_slug": "hot_leads",
      "expected_change": {
        "method": "lead_probability_sum",
        "band": 1
      },
      "measurement_window_days": 7,
      "guardrails": [
        {
          "kpi": "response_latency_p90",
          "max": 24
        }
      ],
      "confounders": [
        "Seasonal gifting demand before Diwali"
      ],
      "tasks": [
        {
          "key": "contact_a",
          "title": "Call or message the top-ranked hot leads ({leads_a})",
          "reason": "Highest expected value and waiting longer than the SLA",
          "effort_min": 60,
          "owner_role": "Founder",
          "success_criterion": "Each of these leads contacted within 24 hours",
          "after": [],
          "gap_days": 0,
          "earliest_day": 1,
          "requires_approval": true
        },
        {
          "key": "contact_b",
          "title": "Contact the remaining hot leads ({leads_b})",
          "reason": "Clear the unattended high-value backlog",
          "effort_min": 50,
          "owner_role": "Founder",
          "success_criterion": "Every unattended hot lead contacted",
          "after": [],
          "gap_days": 0,
          "earliest_day": 1,
          "requires_approval": true
        },
        {
          "key": "sla_alert",
          "title": "Set a {sla_hours}-hour response alert for high-value leads",
          "reason": "Stop the backlog from returning",
          "effort_min": 30,
          "owner_role": "Operations assistant",
          "success_criterion": "Alert fires on a test lead",
          "after": [],
          "gap_days": 0,
          "earliest_day": 1,
          "requires_approval": false
        },
        {
          "key": "followup",
          "title": "Second follow-up for hot leads that have not replied",
          "reason": "Most wins come from the second touch",
          "effort_min": 40,
          "owner_role": "Operations assistant",
          "success_criterion": "Every non-responding hot lead followed up once more",
          "after": [
            "contact_a",
            "contact_b"
          ],
          "gap_days": 3,
          "earliest_day": 1,
          "requires_approval": true
        }
      ]
    },
    {
      "template_id": "tpl_repeat_email_flow",
      "title": "Launch a repeat-buyer email flow",
      "action_type": "outreach",
      "kpi": "repeat_rate",
      "expected_direction": "up",
      "triggers": [
        "improving_repeat_cohort",
        "first_orders_high_repeat_low"
      ],
      "factors": {
        "I": 0.7,
        "F": 0.8,
        "R": 0.9,
        "T": 0.6,
        "E": 0.35,
        "C": 0.1,
        "D": 0.2
      },
      "effort_min": 120,
      "cost_inr": 0,
      "time_to_signal_days": 14,
      "requires_approval": true,
      "approval_reason": "customer_outreach",
      "risks": [
        "Unsubscribes if sent too often"
      ],
      "requires_data": [
        "email_consent"
      ],
      "spend_change": "none",
      "recommendation_slug": "email_retention",
      "expected_change": {
        "method": "relative",
        "low_pct": 5,
        "high_pct": 17
      },
      "measurement_window_days": 30,
      "guardrails": [],
      "confounders": [
        "Seasonal demand"
      ],
      "tasks": [
        {
          "key": "draft",
          "title": "Draft the day-21 replenishment email for first-time buyers",
          "reason": "Extend the higher repeat rate of the email cohort",
          "effort_min": 60,
          "owner_role": "Founder",
          "success_criterion": "Draft approved by the founder",
          "after": [],
          "gap_days": 0,
          "earliest_day": 1,
          "requires_approval": false
        },
        {
          "key": "setup",
          "title": "Set up the email flow trigger at day 21 after the first order",
          "reason": "Automate the repeat-buyer email",
          "effort_min": 45,
          "owner_role": "Operations assistant",
          "success_criterion": "Flow active with the correct segment",
          "after": [
            "draft"
          ],
          "gap_days": 1,
          "earliest_day": 1,
          "requires_approval": false
        },
        {
          "key": "send",
          "title": "Send the flow to the first eligible segment (approval required)",
          "reason": "Start measuring the repeat effect",
          "effort_min": 15,
          "owner_role": "Operations assistant",
          "success_criterion": "First batch sent after approval",
          "after": [
            "setup"
          ],
          "gap_days": 1,
          "earliest_day": 1,
          "requires_approval": true
        }
      ]
    },
    {
      "template_id": "tpl_instagram_attribution_test",
      "title": "Audit Instagram attribution and run one bounded creative/landing test",
      "action_type": "experiment",
      "kpi": "contribution_roas",
      "expected_direction": "up",
      "triggers": [
        "cac_spike",
        "high_spend_low_contribution"
      ],
      "factors": {
        "I": 0.75,
        "F": 0.7,
        "R": 0.8,
        "T": 0.5,
        "E": 0.4,
        "C": 0.3,
        "D": 0.3
      },
      "effort_min": 135,
      "cost_inr": 0,
      "time_to_signal_days": 7,
      "requires_approval": true,
      "approval_reason": "spend",
      "risks": [
        "Small sample in one week",
        "Attribution gaps"
      ],
      "requires_data": [
        "campaign_ids"
      ],
      "spend_change": "reallocate_within_channel_budget",
      "recommendation_slug": "instagram_test",
      "expected_change": {
        "method": "relative",
        "low_pct": 15,
        "high_pct": 44
      },
      "measurement_window_days": 7,
      "guardrails": [
        {
          "kpi": "ad_spend",
          "max": "baseline_value"
        }
      ],
      "confounders": [
        "Contribution uses estimated shipping costs"
      ],
      "tasks": [
        {
          "key": "audit",
          "title": "Audit {channel_title} attribution: UTM tags, pixel events, landing page match",
          "reason": "Rule out tracking loss before changing the campaign",
          "effort_min": 45,
          "owner_role": "Operations assistant",
          "success_criterion": "Attribution gaps listed with a fix or 'none found'",
          "after": [],
          "gap_days": 0,
          "earliest_day": 1,
          "requires_approval": false
        },
        {
          "key": "launch",
          "title": "Launch one creative/landing test inside the current {channel_title} budget",
          "reason": "Test a fix for falling conversion without extra spend",
          "effort_min": 60,
          "owner_role": "Founder",
          "success_criterion": "Test live with spend at or below the current {channel_title} budget",
          "after": [
            "audit"
          ],
          "gap_days": 2,
          "earliest_day": 1,
          "requires_approval": true
        },
        {
          "key": "readout",
          "title": "Review the {channel_title} test readout and decide keep or stop",
          "reason": "Close the loop on the test",
          "effort_min": 30,
          "owner_role": "Founder",
          "success_criterion": "Decision recorded with the numbers",
          "after": [
            "launch"
          ],
          "gap_days": 3,
          "earliest_day": 1,
          "requires_approval": false
        }
      ]
    },
