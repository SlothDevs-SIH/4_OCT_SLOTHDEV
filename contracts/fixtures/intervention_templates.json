    {
      "template_id": "tpl_landing_page_fix",
      "title": "Fix the top drop-off on the landing page",
      "action_type": "content",
      "kpi": "conversion_rate",
      "expected_direction": "up",
      "triggers": [
        "high_traffic_low_leads"
      ],
      "factors": {
        "I": 0.6,
        "F": 0.7,
        "R": 0.9,
        "T": 0.6,
        "E": 0.4,
        "C": 0.1,
        "D": 0.3
      },
      "effort_min": 150,
      "cost_inr": 0,
      "time_to_signal_days": 7,
      "requires_approval": false,
      "approval_reason": null,
      "risks": [
        "Change confounded with campaign changes"
      ],
      "requires_data": [
        "sessions"
      ],
      "spend_change": "none",
      "recommendation_slug": "landing_page_fix",
      "expected_change": {
        "method": "relative",
